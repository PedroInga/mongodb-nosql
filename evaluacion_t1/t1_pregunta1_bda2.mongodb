print("╔══════════════════════════════════════════════════════════════╗");
print("║          EVALUACIÓN T1 - BASE DE DATOS AVANZADO II           ║");
print("║                      PREGUNTA 1                              ║");
print("║              Gestión de TechStore con MongoDB                ║");
print("╚══════════════════════════════════════════════════════════════╝\n");

// ==============================================
// PASO 1: CREAR LA BASE DE DATOS dbTechStore
// ==============================================

print("🔹 PASO 1: Creando base de datos dbTechStore...");
use('dbTechStore');
print("✅ Base de datos 'dbTechStore' creada/seleccionada\n");

// ==============================================
// PASO 2: CREAR COLECCIÓN EQUIPOS (INSERCIÓN UNO POR UNO)
// ==============================================

print("🔹 PASO 2: Creando colección 'equipos' con inserción uno por uno...\n");

// Documento 1: Laptop Asus
db.equipos.insertOne({
    Nombre: "Laptop Asus",
    Categoria: "Portátiles",
    Precio: 2500,
    Stock: 30,
    Accesorios: [
        "Cargador",
        "Funda de protección",
        "Ratón inalámbrico"
    ]
});
print("   ✓ Equipo 1: Laptop Asus insertado");

// Documento 2: Monitor LG
db.equipos.insertOne({
    Nombre: "Monitor LG",
    Categoria: "Monitores",
    Precio: 999,
    Stock: 20,
    Accesorios: [
        "Cable HDMI",
        "Base ajustable",
        "Adaptador de corriente"
    ]
});
print("   ✓ Equipo 2: Monitor LG insertado");

// Documento 3: Teclado Logitech
db.equipos.insertOne({
    Nombre: "Teclado Logitech",
    Categoria: "Teclados",
    Precio: 180,
    Stock: 30,
    Accesorios: [
        "Reposamuñecas",
        "Extractor de teclas",
        "Cable USB desmontable"
    ]
});
print("   ✓ Equipo 3: Teclado Logitech insertado");

// Documento 4: Impresora Epson
db.equipos.insertOne({
    Nombre: "Impresora Epson",
    Categoria: "Impresoras",
    Precio: 1230,
    Stock: 100,
    Accesorios: [
        "Cartucho de tóner",
        "Cable USB",
        "Manual de usuario"
    ]
});
print("   ✓ Equipo 4: Impresora Epson insertado");

// Documento 5: Tablet Lenovo
db.equipos.insertOne({
    Nombre: "Tablet Lenovo",
    Categoria: "Tablets",
    Precio: 1750,
    Stock: 300,
    Accesorios: [
        "Cargador rápido",
        "Funda protectora",
        "Lápiz táctil"
    ]
});
print("   ✓ Equipo 5: Tablet Lenovo insertado");

print("\n✅ Colección 'equipos' creada con " + db.equipos.countDocuments() + " documentos\n");

// ==============================================
// PASO 3: CREAR COLECCIÓN CLIENTES (INSERCIÓN MASIVA)
// ==============================================

db.getName()

print("🔹 PASO 3: Creando colección 'clientes' con inserción masiva...\n");

db.clientes.insertMany([
    {
        Codigo: "001",
        Nombre: "Juan",
        Apellido: "Pérez",
        FechaDeNacimiento: new Date("1990-05-15"),
        Celular: "987654321",
        CategoriasDeInteres: [
            "Laptops",
            "Monitores",
            "Impresoras"
        ]
    },
    {
        Codigo: "002",
        Nombre: "Ana",
        Apellido: "Gómez",
        FechaDeNacimiento: new Date(""),// Sin fecha nacimiento registrado
        Celular: "987654322",
        CategoriasDeInteres: [
            "Tablets",
            "Teclados",
            "Ratones",
            "Monitores"
        ]
    },
    {
        Codigo: "003",
        Nombre: "Luis",
        Apellido: "Martínez",
        FechaDeNacimiento: new Date("1988-11-30"),
        Celular: "987654323",
        CategoriasDeInteres: [
            "Laptops",
            "Accesorios",
            "Impresoras",
            "Teclados"
        ]
    },
    {
        Codigo: "004",
        Nombre: "María",
        Apellido: "López",
        FechaDeNacimiento: new Date("1988-02-17"),
        Celular: "", // Sin celular registrado
        CategoriasDeInteres: [
            "Impresoras",
            "Monitores",
            "Proyectores"
        ]
    },
    {
        Codigo: "005",
        Nombre: "Sofía",
        Apellido: "Ramírez",
        FechaDeNacimiento: new Date("1993-09-25"),
        Celular: "987654326",
        CategoriasDeInteres: [
            "Tablets",
            "Accesorios",
            "Software",
            "Monitores"
        ]
    }
]);

print("✅ Colección 'clientes' creada con " + db.clientes.countDocuments() + " documentos\n");

// ==============================================
// VERIFICACIÓN COMPLETA DE DATOS
// ==============================================

print("╔══════════════════════════════════════════════════════════════╗");
print("║                  VERIFICACIÓN DE DATOS                       ║");
print("╚══════════════════════════════════════════════════════════════╝\n");

// EQUIPOS
print("📦 COLECCIÓN EQUIPOS:");
print("─────────────────────────────────────────────────────────────────");
db.equipos.find().forEach(equipo => {
    print(`\n🔧 ${equipo.Nombre}`);
    print(`   Categoría: ${equipo.Categoria}`);
    print(`   Precio: S/ ${equipo.Precio}`);
    print(`   Stock: ${equipo.Stock} unidades`);
    print(`   Accesorios: ${equipo.Accesorios.join(", ")}`);
});

print("\n\n👥 COLECCIÓN CLIENTES:");
print("─────────────────────────────────────────────────────────────────");
db.clientes.find().forEach(cliente => {
    print(`\n👤 ${cliente.Nombre} ${cliente.Apellido} (Código: ${cliente.Codigo})`);
    print(`   Nacimiento: ${cliente.FechaDeNacimiento.toISOString().split('T')[0]}`);
    print(`   Celular: ${cliente.Celular || 'No registrado'}`);
    print(`   Intereses: ${cliente.CategoriasDeInteres.join(", ")}`);
});

// ==============================================
// ESTADÍSTICAS FINALES
// ==============================================

print("\n\n╔══════════════════════════════════════════════════════════════╗");
print("║                     ESTADÍSTICAS FINALES                     ║");
print("╚══════════════════════════════════════════════════════════════╝\n");

const totalEquipos = db.equipos.countDocuments();
const totalClientes = db.clientes.countDocuments();
const valorTotalInventario = db.equipos.aggregate([
    { $group: { _id: null, total: { $sum: { $multiply: ["$Precio", "$Stock"] } } } }
]).toArray()[0].total;

print("📊 EQUIPOS:");
print(`   • Total de equipos: ${totalEquipos}`);
print(`   • Valor total del inventario: S/ ${valorTotalInventario.toLocaleString()}`);
print(`   • Unidades en stock: ${db.equipos.aggregate([{$group: {_id: null, total: {$sum: "$Stock"}}}]).toArray()[0].total}`);

print("\n📊 CLIENTES:");
print(`   • Total de clientes: ${totalClientes}`);
print(`   • Con celular registrado: ${db.clientes.countDocuments({ Celular: { $ne: "" } })}`);
print(`   • Sin celular registrado: ${db.clientes.countDocuments({ Celular: "" })}`);

// Categorías más populares
print("\n📊 CATEGORÍAS MÁS POPULARES ENTRE CLIENTES:");
const categorias = {};
db.clientes.find().forEach(cliente => {
    cliente.CategoriasDeInteres.forEach(cat => {
        categorias[cat] = (categorias[cat] || 0) + 1;
    });
});
Object.keys(categorias).sort((a, b) => categorias[b] - categorias[a]).forEach(cat => {
    print(`   • ${cat}: ${categorias[cat]} cliente(s) interesado(s)`);
});

