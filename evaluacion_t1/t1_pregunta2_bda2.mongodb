// ==============================================
// PREGUNTA 2 - CONSULTAS SIMPLIFICADAS
// Versiones cortas para referencia rápida
// ==============================================

use('dbTechStore');

// ============================================
// CONSULTA 1: Listar los 3 primeros documentos de equipos
// ============================================

db.equipos.find().limit(3);

// Versión con formato legible
db.equipos.find().limit(3).forEach(equipo => {
    printjson(equipo);
});

// ============================================
// CONSULTA 2: Listar los 2 primeros documentos de clientes
// ============================================

db.clientes.find().limit(2);

// Versión con formato legible
db.clientes.find().limit(2).forEach(cliente => {
    printjson(cliente);
});

// ============================================
// CONSULTA 3: Listar solo nombre, apellido, celular y categorías de interés
// ============================================
db.clientes.find(
    {},
    {
        Nombre: 1,
        Apellido: 1,
        Celular: 1,
        CategoriasDeInteres: 1,
        _id: 0
    }
).forEach(cliente => {
    printjson(cliente);
});


// ============================================
// CONSULTA 4: Listar equipos con stock >= 100
// ============================================

db.equipos.find({ Stock: { $gte: 100 } });

// Versión con formato legible
db.equipos.find({ Stock: { $gte: 100 } }).forEach(equipo => {
    printjson(equipo);
});
