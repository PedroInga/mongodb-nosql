// PREGUNTA 3 - Consulta 1
// Mostrar nombres, ventas mensuales y sede
// Después del tercer documento (skip 3)
// Filtrar por sede "Sucursal Sur"
// Ordenar por cualquier campo

db.sellers.find(
    {
        sucursal: { $eq: "Sucursal Sur" }
    },
    {
        _id: 0,
        nombre: 1,
        "metas.ventasMensuales": 1,
        sucursal: 1
    }
).sort({ nombre: 1 }).skip(3)


// PREGUNTA 3 - Consulta 2
// Mostrar nombres, apellidos y fecha de ingreso (sin _id)
// Ordenar descendente por apellidos
// Recuperar los 4 primeros documentos
// Filtrar vendedores con clientesNuevos <= 20

db.sellers.find(
    {
        "metas.clientesNuevos": { $lte: 20 }
    },
    {
        _id: 0,
        nombre: 1,
        apellidos: 1,
        fechaIngreso: 1
    }
).sort({ apellidos: -1 }).limit(4)


// PREGUNTA 3 - Consulta 3
// Mostrar vendedores con ventasMensuales >= 10000 y < 11000
// Ordenar descendente por nombre

db.sellers.find(
    {
        "metas.ventasMensuales": {
            $gte: 10000,
            $lt: 11000
        }
    }
).sort({ nombre: -1 })